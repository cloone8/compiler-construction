<!--
 This XML file is the "command center" of your compiler.
 Here, we define the structure of the abstract syntax tree as well as the
 traversals to process it.
-->

<?xml-stylesheet href="ast.html.xsl" type="text/xsl" name="HTML" media="screen"?>
<definition version="0.9" >

<!--
  =========================================================================
-->

    <attributetypes>
        <type name="String" ctype="char*" init="NULL" copy="function" />
        <type name="Int" ctype="int" init="0" copy="literal" />
        <type name="Bool" ctype="bool" init="FALSE" copy="literal" />
        <type name="Float" ctype="float" init="0.0" copy="literal" />
        <type name="MonOp" ctype="monop" init="MO_unknown" copy="literal" />
        <type name="BinOp" ctype="binop" init="BO_unknown" copy="literal" />
        <type name="Link" ctype="node*" init="NULL" copy="lookup" />
        <type name="CompilerPhase" ctype="compiler_phase_t" init="PH_initial" copy="literal" />
        <type name="Type" ctype="type" init="TP_void" copy="literal" />
        <type name="SymbolTable" ctype="symbol_table*" init="NULL" copy="literal" />
    </attributetypes>

<!--
  =========================================================================
-->

    <phases>
        <!-- id is the short id of the traversal
            name is a descriptive name
            default gives the default traversal mode
            user  a user definedALWAYS function
            sons  TravSons
            none  TravNone
            error TravError
            include the include file needed for the traversal
        -->
        <general>
            <traversal id="PRT" name="Print Syntax Tree" default="user" include="print.h" />
            <traversal id="COPY" name="Copy Syntax Tree" default="user" include="copy_node.h" />
            <traversal id="FREE" name="Free Syntax Tree" default="user" include="free_node.h" />
            <traversal id="CHK" name="Check Syntax Tree" default="user" include="check.h" />

            <traversal id="STB" name="Build symbol table" default="sons" include="build_symbol_table.h">
                <travuser>
                    <node name="Global" />
                    <node name="GlobalDefinition" />
                    <node name="Function" />
                    <node name="FunctionDefinition" />
                    <node name="BasicParameter" />
                    <node name="ArrayParameter" />
                    <node name="FunctionVarDeclaration" />
                    <node name="For" />
                    <node name="VarAssign" />
                    <node name="ArrayVarAssign" />
                    <node name="BasicVarDeclaration" />
                    <node name="ArrayVarDeclaration" />
                    <node name="FunCall" />
                    <node name="FunCallParameter" />
                    <node name="varRead" />
                    <node name="ArrayVarRead" />
                </travuser>
            </traversal>

        </general>
    </phases>

    <!--
    =========================================================================
    -->

    <nodesets>
        <nodeset name="DeclarationType">
            <target>
                <node name="Function" />
                <node name="Global" />
            </target>
        </nodeset>
        <nodeset name="StatementTypes">
            <target>
                <node name="Return" />
                <node name="Branch" />
                <node name="FunCall" />
                <node name="For" />
                <node name="While" />
                <node name="DoWhile" />
                <node name="VarAssign" />
                <node name="ArrayVarAssign" />
            </target>
        </nodeset>
        <nodeset name="ExprTypes">
            <target>
                <node name="VarRead" />
                <node name="ArrayVarRead" />
                <node name="BinOp" />
                <node name="MonOp" />
                <node name="Cast" />
                <node name="Constant" />
                <node name="FunCall" />
                <node name="ExprArray" />
            </target>
        </nodeset>
        <nodeset name="ConstantTypes">
            <target>
                <node name="FloatConst" />
                <node name="IntConst" />
                <node name="BoolConst" />
            </target>
        </nodeset>
        <nodeset name="FunctionParameterTypes">
            <target>
                <node name="BasicParameter" />
                <node name="ArrayParameter" />
            </target>
        </nodeset>
        <nodeset name="FunctionVarDeclarationTypes">
            <target>
                <node name="BasicVarDeclaration" />
                <node name="ArrayVarDeclaration" />
            </target>
        </nodeset>
        <nodeset name="GlobalArrayDims">
            <target>
                <node name="ArrayDimensionVars" />
                <node name="ExprArray" />
            </target>
        </nodeset>
        <nodeset name="ExprArrayOrExpr">
            <target>
                <node name="Expr" />
                <node name="ExprArray" />
            </target>
        </nodeset>
    </nodesets>

    <!--
    =========================================================================
    -->

    <syntaxtree>
        <!--
        Node Program:
         -->
        <node name="Program">
            <description>
                Main node of the program to be used for metadata
            </description>
            <sons>
                <son name="first">
                    <targets>
                            <target mandatory="yes" >
                                <node name="Declaration" />
                                <phases>
                                    <all />
                                </phases>
                            </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="SymbolTable">
                    <type name="SymbolTable">
                        <targets>
                            <target mandatory="no">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>

        </node>

        <!--
        Node Declaration:
         -->
        <node name="Declaration">
            <description>
                Sequence of declarations
            </description>
            <sons>
                <son name="current">
                    <targets>
                            <target mandatory="yes" >
                                <set name="DeclarationType" />
                                <phases>
                                    <all />
                                </phases>
                            </target>
                    </targets>
                </son>
                <son name="next">
                    <targets>
                            <target mandatory="no" >
                                <node name="Declaration" />
                                <phases>
                                    <all />
                                </phases>
                            </target>
                    </targets>
                </son>
            </sons>
        </node>

        <!--
        Node Function
         -->

        <node name="Function">
            <description>
                Function declaration
            </description>
            <sons>
                <son name="parameters">
                    <targets>
                        <target mandatory="no" >
                            <set name="FunctionParameterTypes" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="definition">
                    <targets>
                        <target mandatory="no" >
                            <node name="FunctionDefinition" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="name">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
                <attribute name="type">
                    <type name="Type">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node BasicParameter
         -->

        <node name="BasicParameter">
            <description>
                Basic (non-array) function parameter
            </description>
            <sons>
                <son name="next">
                    <targets>
                        <target mandatory="no" >
                            <set name="FunctionParameterTypes" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="name">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
                <attribute name="type">
                    <type name="Type">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node ArrayParameter
         -->

        <node name="ArrayParameter">
            <description>
                Array function parameter
            </description>
            <sons>
                <son name="next">
                    <targets>
                        <target mandatory="no" >
                            <set name="FunctionParameterTypes" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="dimensions">
                    <targets>
                        <target mandatory="yes" >
                            <node name="ArrayDimensionVars" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="name">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
                <attribute name="type">
                    <type name="Type">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node ArrayDimensionVars
         -->

        <node name="ArrayDimensionVars">
            <description>
                Array function parameter dimension linked list
            </description>
            <sons>
                <son name="next">
                    <targets>
                        <target mandatory="no" >
                            <node name="ArrayDimensionVars" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="name">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node FunctionDefinition
         -->

        <node name="FunctionDefinition">
            <description>
                Function definition. This includes the actual code for the function.
            </description>
            <sons>
                <son name="FunctionBody">
                    <targets>
                        <target mandatory="yes">
                            <node name="FunctionBody" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="isexport">
                    <type name="Bool">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node FunctionBody
         -->

        <node name="FunctionBody">
            <description>
                The body of a function.
            </description>
            <sons>
                <son name="vardeclarations">
                    <targets>
                        <target mandatory="no">
                            <node name="FunctionVarDeclaration" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
                <son name="localfunctions">
                    <targets>
                        <target mandatory="no">
                            <node name="LocalFunction" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
                <son name="statements">
                    <targets>
                        <target mandatory="no">
                            <node name="Statements" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
            </attributes>
        </node>

        <!--
        Node FunctionVarDeclaration
         -->

        <node name="FunctionVarDeclaration">
            <description>
                All variable declarations in a function
            </description>
            <sons>
                <son name="current">
                    <targets>
                        <target mandatory="yes">
                            <set name="FunctionVarDeclarationTypes" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
                <son name="next">
                    <targets>
                        <target mandatory="no">
                            <node name="FunctionVarDeclaration" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
            </attributes>
        </node>

        <!--
        Node LocalFunction
         -->

        <node name="LocalFunction">
            <description>
                Local function definition
            </description>
            <sons>
                <son name="current">
                    <targets>
                        <target mandatory="yes">
                            <node name="Function" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
                <son name="next">
                    <targets>
                        <target mandatory="no">
                            <node name="LocalFunction" />
                                <phases>
                                    <all />
                                </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
            </attributes>
        </node>

        <!--
        Node Statements
        -->

        <node name="Statements">
            <description>
                A single or collection of statements.
            </description>
            <sons>
                <son name="current">
                    <targets>
                        <target mandatory="yes">
                            <set name="StatementTypes" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="next">
                    <targets>
                        <target mandatory="no">
                            <node name="Statements" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
        </node>

        <!--
        Node BasicVarDeclaration
        -->

        <node name="BasicVarDeclaration">
            <description>
                Variable declaration inside a function.
            </description>
            <sons>
                <son name="initval">
                    <targets>
                        <target mandatory="no">
                        <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="varname">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
                <attribute name="type">
                    <type name="Type">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node ArrayVarDeclaration
        -->

        <node name="ArrayVarDeclaration">
            <description>
                Array declaration inside a function.
            </description>
            <sons>
                <son name="initval">
                    <targets>
                        <target mandatory="no">
                        <node name="ExprArray" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="dimensions">
                    <targets>
                        <target mandatory="yes">
                        <node name="ExprArray" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="varname">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
                <attribute name="type">
                    <type name="Type">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node ExprArray
         -->

        <node name="ExprArray">
            <description>
                Array of multiple expressions.
            </description>
            <sons>
                <son name="next">
                    <targets>
                        <target mandatory="no">
                        <node name="ExprArray" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="current">
                    <targets>
                        <target mandatory="yes">
                        <set name="ExprArrayOrExpr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
        </node>

        <!--
        Node GlobalDefinition
         -->

        <node name="GlobalDefinition">
            <description>
                Global definition. This includes the actual value for the global.
            </description>
            <sons>
                <son name="values">
                    <targets>
                        <target mandatory="no" >
                            <node name="ExprArray" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="isexport">
                    <type name="Bool">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node For
         -->

        <node name="For">
            <description>
                For loop.
            </description>
            <sons>
                <son name="counterinit">
                    <targets>
                        <target mandatory="yes">
                        <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="condition">
                    <targets>
                        <target mandatory="yes">
                        <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="step">
                    <targets>
                        <target mandatory="no">
                        <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="code">
                    <targets>
                        <target mandatory="yes">
                        <node name="Statements" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="countername">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node While
         -->

        <node name="While">
            <description>
                While loop.
            </description>
            <sons>
                <son name="condition">
                    <targets>
                        <target mandatory="yes">
                        <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="code">
                    <targets>
                        <target mandatory="yes">
                        <node name="Statements" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
        </node>

        <!--
        Node Do while
         -->

        <node name="DoWhile">
            <description>
                Do while loop.
            </description>
            <sons>
                <son name="condition">
                    <targets>
                        <target mandatory="yes">
                            <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="code">
                    <targets>
                        <target mandatory="yes">
                            <node name="Statements" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
        </node>

        <!--
        Node Global
        -->

        <node name="Global">
            <description>
                Global declaration
            </description>
            <sons>
                <son name="definition">
                    <targets>
                            <target mandatory="no" >
                                <node name="GlobalDefinition" />
                                <phases>
                                    <all />
                                </phases>
                            </target>
                    </targets>
                </son>
                <son name="dimensions">
                    <targets>
                            <target mandatory="no" >
                                <set name="GlobalArrayDims" />
                                <phases>
                                    <all />
                                </phases>
                            </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="name">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
                <attribute name="type">
                    <type name="Type">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node Error:
        -->
        <node name="Error">
            <description>represents internal Error representation constructor</description>
            <sons>
                <son name="Next">
                    <targets>
                        <target mandatory="no" >
                            <node name="Error" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="message">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
                <attribute name="anyphase">
                    <type name="CompilerPhase">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
            <flags></flags>
        </node>

        <!--
        Node FunCall
         -->
        <node name="FunCall">
            <description>
                Function call. Includes the name of the function and the parameters
            </description>
            <sons>
                <son name="params">
                    <targets>
                        <target mandatory="no" >
                            <node name="FunCallParameter" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
            <attributes>
                <attribute name="functionname">
                    <type name="String">
                        <targets>
                            <target mandatory="yes">
                                <phases>
                                    <all />
                                </phases>
                            </target>
                        </targets>
                    </type>
                </attribute>
            </attributes>
        </node>

        <!--
        Node FunCallParameter
         -->

        <node name="FunCallParameter">
            <description>
                Function call parameter. Includes the expression that determines this value and a link to a
                potential next parameter
            </description>
            <sons>
                <son name="value">
                    <targets>
                        <target mandatory="yes" >
                            <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="next">
                    <targets>
                        <target mandatory="no" >
                            <node name="FunCallParameter" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
        </node>

        <!--
        Node Return
         -->
        <node name="Return">
            <description>
                Return statement. Includes the return value
            </description>
            <sons>
                <son name="value">
                    <targets>
                        <target mandatory="no" >
                            <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
            </sons>
        </node>

        <!--
        Node Branch
         -->
        <node name="Branch">
            <description>
                Branch statements. Includes the condition and the one or two possible branches.
            </description>
            <sons>
                <son name="condition">
                    <targets>
                        <target mandatory="yes" >
                            <node name="Expr" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="thenbranch">
                    <targets>
                        <target mandatory="yes" >
                            <node name="Statements" />
                            <phases>
                                <all />
                            </phases>
                        </target>
                    </targets>
                </son>
                <son name="elsebranch">
                    <targets>
                        <target mandatory="no" >
                            <node name="Statements" />
