/*
 * Phase and subphase definitions
 */
#include "phase_initialise_defs.mac"

/******************************************************************************/


PHASE(ld,
       "Loading CiviC program",
       ALWAYS)

SUBPHASE(cpp,
          "Running C preprocessor",
          SPdoRunPreProcessor,
          ALWAYS,
          ld)

SUBPHASE(scp,
          "Parsing source code",
          SPdoScanParse,
          ALWAYS,
          ld)

SUBPHASE(prt_ast, "Print ast", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_START_END), ld)

ENDPHASE(ld)


/******************************************************************************/


PHASE(sa,
       "Perform context analysis",
       ALWAYS)

SUBPHASE( stb,
          "Checking variable scopes",
          STBdo,
          ALWAYS,
          sa)

SUBPHASE( ftb,
          "Finding functions",
          FTBdo,
          ALWAYS,
          sa)

SUBPHASE( cfs,
          "Check function scope",
          CFSdo,
          ALWAYS,
          sa)

SUBPHASE(prt_sa_ast, "Printing symbol tables", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_END_PHASE), sa)

ENDPHASE(sa)


/******************************************************************************/

PHASE(i2a,
      "Splitting variable declarations and assignments",
      ALWAYS)

SUBPHASE( vsp,
          "Splitting variables",
          VSPdo,
          ALWAYS,
          i2a)

SUBPHASE( fsp,
          "Lifting and splitting for loop counters",
          FSPdo,
          ALWAYS,
          i2a)

SUBPHASE( i2a_vrn,
          "Updating renamed variable names",
          VRNdo,
          ALWAYS,
          i2a)

SUBPHASE(prt_rn_ast, "Printing split AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_END_PHASE), i2a)

ENDPHASE(i2a)

/******************************************************************************/


PHASE(sac,
       "Continuing semantic analysis",
       ALWAYS)

SUBPHASE( tc,
           "Type checking",
           TCdo,
           ALWAYS,
           sac)

SUBPHASE( rc,
           "Return checking",
           RCdo,
           ALWAYS,
           sac)

SUBPHASE(prt_rc_ast, "Printing implicit return added AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_END_PHASE), sac)

ENDPHASE(sac)

/******************************************************************************/

PHASE(ict,
       "Doing internal code transformations",
       ALWAYS)

SUBPHASE(app,
         "Expanding array function call parameters",
         APPdo,
         ALWAYS,
         ict)

SUBPHASE( app_vrn,
          "Updating renamed variable names",
          VRNdo,
          ALWAYS,
          ict)

SUBPHASE(prt_app_ast, "Printing split AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_ALL), ict)

SUBPHASE( tc_app,
           "Checking expanded array types",
           TCdo,
           ALWAYS,
           ict)

SUBPHASE(bdc,
         "Boolean compiling",
         BDCdo,
         ALWAYS,
         ict)

SUBPHASE(prt_bdc_ast, "Printing boolean compiled AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_ALL), ict)

SUBPHASE(cbc,
         "Compiling boolean cast expressions",
         CBCdo,
         ALWAYS,
         ict)

SUBPHASE(prt_cbc_ast, "Printing boolean cast compiled AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_ALL), ict)

SUBPHASE(lad,
         "Lowering array dimensions",
         LADdo,
         ALWAYS,
         ict)

SUBPHASE(prt_lad_ast, "Printing array dimension lowered AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_ALL), ict)

SUBPHASE(ftw,
         "Transforming for-loops to while-loops",
         FTWdo,
         ALWAYS,
         ict)

SUBPHASE(wtdw,
         "While to do-while",
         WTDWdo,
         ALWAYS,
         ict)

SUBPHASE(prt_ict_ast, "Printing transformed AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_END_PHASE), ict)

ENDPHASE(ict)
/******************************************************************************/

PHASE(su,
       "Stripping unused code",
       ALWAYS)

SUBPHASE(suf, "Stripping unused functions", SUFdo, ALWAYS, su)

SUBPHASE(prt_su, "Printing stripped AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_END_PHASE), su)

ENDPHASE(su)
/******************************************************************************/

PHASE(cg,
       "Generating Code",
       ALWAYS)

SUBPHASE(prt_fin_ast, "Print final AST", PRTdoPrint, ONLYIF(myglobal.printtree >= PRINT_START_END), cg)

SUBPHASE(prt, "Generating byte code", GBCdoGenByteCode, ALWAYS, cg)


SUBPHASE(frtr,
          "De-allocating syntax tree representation",
          FREEdoFreeTree,
          ALWAYS,
          cg)

SUBPHASE(fin,
         "Cleaning up compiler memory",
         FINdoFinalise,
         ALWAYS,
         cg)

ENDPHASE(cg)


/******************************************************************************/

#include "phase_undefine_defs.mac"
