/*
 * Phase and subphase definitions
 */


#include "phase_initialise_defs.mac"

/******************************************************************************/


PHASE(ld,
       "Loading CiviC program",
       ALWAYS)

SUBPHASE(cpp,
          "Running C preprocessor",
          SPdoRunPreProcessor,
          ALWAYS,
          ld)

SUBPHASE(scp,
          "Parsing source code",
          SPdoScanParse,
          ALWAYS,
          ld)
// SUBPHASE(prt_ast, "Print ast", PRTdoPrint, ALWAYS, ld)

ENDPHASE(ld)


/******************************************************************************/


PHASE(sa,
       "Perform context analysis",
       ALWAYS)

SUBPHASE( stb,
          "Checking variable scopes",
          STBdo,
          ALWAYS,
          sa)

SUBPHASE( ftb,
          "Finding functions",
          FTBdo,
          ALWAYS,
          sa)

SUBPHASE( cfs,
          "Check function scope",
          CFSdo,
          ALWAYS,
          sa)

#ifndef DBUG_OFF
SUBPHASE(prt_sa_ast, "Printing symbol tables", PRTdoPrint, ALWAYS, sa)
#endif

ENDPHASE(sa)


/******************************************************************************/

PHASE(i2a,
      "Splitting variable declarations and assignments",
      ALWAYS)

SUBPHASE( vsp,
          "Splitting variables",
          VSPdo,
          ALWAYS,
          i2a)

SUBPHASE( fsp,
          "Lifting and splitting for loop counters",
          FSPdo,
          ALWAYS,
          i2a)

SUBPHASE( vrn,
          "Updating renamed variable names",
          VRNdo,
          ALWAYS,
          i2a)

#ifndef DBUG_OFF
SUBPHASE(prt_rn_ast, "Printing split AST", PRTdoPrint, ALWAYS, i2a)
#endif

ENDPHASE(i2a)

/******************************************************************************/


PHASE(sac,
       "Continuing semantic analysis",
       ALWAYS)

SUBPHASE( tc,
           "Type checking",
           TCdo,
           ALWAYS,
           sac)

ENDPHASE(sac)

/******************************************************************************/

PHASE(ict,
       "Doing internal code transformations",
       ALWAYS)

SUBPHASE(app,
         "Expanding array function call parameters",
         APPdo,
         ALWAYS,
         ict)

#ifndef DBUG_OFF
SUBPHASE(prt_app_ast, "Printing split AST", PRTdoPrint, ALWAYS, ict)
#endif

SUBPHASE( tc,
           "Checking expanded array types",
           TCdo,
           ALWAYS,
           ict)

#ifndef DBUG_OFF
SUBPHASE(prt_apptc_ast, "Printing split AST", PRTdoPrint, ALWAYS, ict)
#endif

SUBPHASE(bdc,
         "Boolean compiling",
         BDCdo,
         ALWAYS,
         ict)

SUBPHASE(cbc,
         "Compiling boolean cast expressions",
         CBCdo,
         ALWAYS,
         ict)

ENDPHASE(ict)

/******************************************************************************/

PHASE(cg,
       "Generating Code",
       ALWAYS)
SUBPHASE(prt, "Generating byte code", GBCdoGenByteCode, ALWAYS, cg)


SUBPHASE(frtr,
          "De-allocating syntax tree representation",
          FREEdoFreeTree,
          ALWAYS,
          cg)

SUBPHASE(fin,
         "Cleaning up compiler memory",
         FINdoFinalise,
         ALWAYS,
         cg)

ENDPHASE(cg)


/******************************************************************************/

#include "phase_undefine_defs.mac"
