/*
 * Phase and subphase definitions
 */


#include "phase_initialise_defs.mac"

/******************************************************************************/


PHASE(ld,
       "Loading CiviC program",
       ALWAYS)

SUBPHASE(cpp,
          "Running C preprocessor",
          SPdoRunPreProcessor,
          ALWAYS,
          ld)

SUBPHASE(scp,
          "Parsing source code",
          SPdoScanParse,
          ALWAYS,
          ld)
SUBPHASE(prt_ast, "Print ast", PRTdoPrint, ALWAYS, ld)

ENDPHASE(ld)


/******************************************************************************/


PHASE(sa,
       "Perform context analysis",
       ALWAYS)

SUBPHASE( stb,
          "Checking variable scopes",
          STBdo,
          ALWAYS,
          sa)

SUBPHASE( ftb,
          "Finding functions",
          FTBdo,
          ALWAYS,
          sa)

SUBPHASE( cfs,
          "Check function scope",
          CFSdo,
          ALWAYS,
          sa)

ENDPHASE(sa)


/******************************************************************************/

PHASE(i2a,
      "Splitting variable declarations and assignments",
      ALWAYS)

SUBPHASE( asp,
          "Splitting array variables",
          ASPdo,
          ALWAYS,
          i2a)

#ifndef DBUG_OFF
SUBPHASE(prt_sp_ast1, "Printing array split AST", PRTdoPrint, ALWAYS, i2a)
#endif

SUBPHASE( bsp,
          "Splitting basic variables",
          BSPdo,
          ALWAYS,
          i2a)

#ifndef DBUG_OFF
SUBPHASE(prt_sp_ast, "Printing total split AST", PRTdoPrint, ALWAYS, i2a)
#endif

ENDPHASE(i2a)

/******************************************************************************/


PHASE(cg,
       "Generating Code",
       ALWAYS)
SUBPHASE(prt, "Generating byte code", GBCdoGenByteCode, ALWAYS, cg)


SUBPHASE(frtr,
          "De-allocating syntax tree representation",
          FREEdoFreeTree,
          ALWAYS,
          cg)

SUBPHASE(fin,
         "Cleaning up compiler memory",
         FINdoFinalise,
         ALWAYS,
         cg)

ENDPHASE(cg)


/******************************************************************************/

#include "phase_undefine_defs.mac"
