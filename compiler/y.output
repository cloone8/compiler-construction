   52 statement: ID LET expr SEMICOLON
   53          | ID BRACKET_L BRACKET_R SEMICOLON
   54          | ID BRACKET_L exprs BRACKET_R SEMICOLON
   55          | IF BRACKET_L expr BRACKET_R block
   56          | IF BRACKET_L expr BRACKET_R block ELSE block
   57          | WHILE BRACKET_L expr BRACKET_R block
   58          | DO block WHILE BRACKET_L expr BRACKET_R SEMICOLON
   59          | FOR BRACKET_L INTTYPE ID LET expr COMMA expr BRACKET_R block
   60          | FOR BRACKET_L INTTYPE ID LET expr COMMA expr COMMA expr BRACKET_R block
   61          | RETURN SEMICOLON
   62          | RETURN expr SEMICOLON
   63          | ID SQR_BRACKET_L expr SQR_BRACKET_R LET expr SEMICOLON

   64 arrexpr: SQR_BRACKET_L exprs SQR_BRACKET_R
   65        | expr

   66 block: BRACE_L BRACE_R
   67      | BRACE_L statements BRACE_R
   68      | statement

   69 exprs: expr exprs
   70      | expr

   71 expr: BRACKET_L expr BRACKET_R
   72     | expr binop expr
   73     | monop expr
   74     | BRACKET_L basictype BRACKET_R expr
