export int gcd(int a, int b) {
    int temp;
    while (b != 0) {
        temp = b;
        b = a % b;
        a = temp;
    }

    return a;
}

export int fac(int n) {
    if(n == 0) {
        return 1;
    } else {
        return (n * fac(n - 1));
    }

    return -1;
}

export int fib(int n) {
    if(n == 0) {
        return 0;
    } else if(n == 1) {
        return 1;
    } else {
        return fib(n - 2) + fib(n - 1);
    }

    return -1;
}

export bool isprime(int n) {
    if(n < 2) {
        return false;
    }

    for(int i = 2, n, 1) {
        if(n % i == 0) {
            return false;
        }
    }

    return true;
}
