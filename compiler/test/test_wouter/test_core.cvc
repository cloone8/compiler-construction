#include "civic.h"

extern int gcd(int a,int b);
extern int fac(int n);
extern int fib(int n);
extern bool isprime(int n);

export int main() {
    printInt(gcd(10,6));
    printNewlines(1);
    printInt(fac(5));
    printNewlines(1);
    printInt(fib(10));
    printNewlines(1);
    if(isprime(7)) {
        printInt(1);
    } else {
        printInt(0);
    }
    printNewlines(1);

    return 0;
}
