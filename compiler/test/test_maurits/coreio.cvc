extern int fib(int n);
extern void printInt(int val);
extern void printSpaces(int val);

export void fibs(int n) {
	for (int i = 0, n, 1) {
		printInt(fib(i));
		printSpaces(1);
	}
}

export void primes(int n) {
	bool isprime(int n) {
		int i = 5;
		if (n <= 3) {
			return n > 1;
		} else if (n % 2 == 0 || n % 3 == 0) {
			return false;
		}
		while (i * i <= n) {
			if (n % i == 0 || n % (i + 2) == 0) {
				return false;
			}
			i = i + 6;
		}
		return true;
	}
	for (int i = 0, n, 1) {
		if (isprime(i)) {
			printInt(i);
			printSpaces(1);
		}
	}
}
