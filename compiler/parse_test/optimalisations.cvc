int test() {
    return 1;
}

export int main() {
    int a = -1;
    bool b = false;
    int c = -(2 * 6) + 7 / (6 - 1);
    float d = -(2.7 * 6.2) + 7.0 - 5.1;
    bool e = true + false * false * !true;

    a = a + 1;
    a = a - 1;
    a = a + 2;
    a = 5 + a;
    a = 1 + a;
    a = -1 + a;

    for(int i = 0, 10, 1) {
        a = a + 1;
    }

    for(int i = 0, 10, test()) {
        a = a - 1;
    }

    for(int i = 10, 0, -1) {
        a = a + -1;
    }

    for(int i = 10, 0, -test()) {
        a = a + -1;
    }

    for(int i = 0, test(), 2) {
        a = a - 1;
    }

    for(int i = 0, test(), test()) {
        a = a - 1;
    }

    a = a * 0;
    a = a - 0;
    a = a + 0;
    a = 0 / a;
    // a = a / 0;
    // a = a % 0;
    a = a % a;
    a = 0 % a;

    d = d * 0.0;
    d = d - 0.0;
    d = d + 0.0;
    d = 0.0 / d;

    b = b + false;
    b = b * false;
    b = b + true;
    b = b * true;

    return 1;
}
